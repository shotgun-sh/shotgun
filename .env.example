# Shotgun Account API Configuration (LiteLLM Proxy)
SHOTGUN_API_KEY=your_shotgun_api_key_here

# Feature Flags
# Enable Shotgun Account provider option in config UI (default: false)
SHOTGUN_ACCOUNT_ENABLED=false

# Logfire (Pydantic) Telemetry Configuration
LOGFIRE_ENABLED=false
LOGFIRE_TOKEN=your_logfire_token_here

# PyPI Publishing Configuration
PYPI_TOKEN=your_pypi_api_token_here
TEST_PYPI_TOKEN=your_test_pypi_api_token_here
