# Shotgun Account API Configuration (LiteLLM Proxy)
SHOTGUN_API_KEY=your_shotgun_api_key_here

# =============================================================================
# Telemetry Configuration (SHOTGUN_ prefixed for runtime override)
# =============================================================================
# These keys are typically embedded at build time via hatch build hooks.
# The SHOTGUN_ prefixed environment variables can be used to override at runtime.

# Sentry Error Tracking
# Runtime override: export SHOTGUN_SENTRY_DSN="your_sentry_dsn"
SHOTGUN_SENTRY_DSN=

# PostHog Analytics
# Runtime override: export SHOTGUN_POSTHOG_API_KEY="your_posthog_api_key"
# Note: Hardcoded key "phc_KKnChzZUKeNqZDOTJ6soCBWNQSx3vjiULdwTR9H5Mcr" was removed
# from posthog_telemetry.py on 2025-10-29 and replaced with build constants.
SHOTGUN_POSTHOG_API_KEY=
SHOTGUN_POSTHOG_PROJECT_ID=

# Logfire (Pydantic) Observability
# Runtime override: export SHOTGUN_LOGFIRE_ENABLED="true"
# Note: Logfire is only embedded in dev builds (versions containing dev, rc, alpha, beta)
SHOTGUN_LOGFIRE_ENABLED=false
SHOTGUN_LOGFIRE_TOKEN=

# =============================================================================
# Optional Configuration (SHOTGUN_ prefixed)
# =============================================================================

# Logging Configuration
SHOTGUN_LOG_LEVEL=INFO
SHOTGUN_LOGGING_TO_CONSOLE=false
SHOTGUN_LOGGING_TO_FILE=true

# Testing / Development Configuration
SHOTGUN_HOME=~/.shotgun-sh
SHOTGUN_PIPX_SIMULATE=false
SHOTGUN_WEB_BASE_URL=https://api-219702594231.us-east4.run.app
SHOTGUN_ACCOUNT_LLM_BASE_URL=https://litellm-219702594231.us-east4.run.app

# =============================================================================
# PyPI Publishing Configuration
# =============================================================================
PYPI_TOKEN=your_pypi_api_token_here
TEST_PYPI_TOKEN=your_test_pypi_api_token_here
